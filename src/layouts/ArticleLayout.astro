---
/**
 * 文章页布局（TOFU/MOFU 栏目通用）：
 * 正文 + 侧边栏 TOP3 + FAQ（GEO 模块）+ 文末 CTA 卡（由 frontmatter cta 决定指向）+ 相关文章。
 *
 * SEO/GEO：Article + BreadcrumbList + FAQPage（有 faq 时）结构化数据。
 */
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SidebarTop3 from '../components/SidebarTop3.astro';
import CtaCard from '../components/CtaCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, sectionById, type SectionId } from '../data/site';

interface Props {
  entry: any;
  section: SectionId;
}

const { entry, section } = Astro.props;
const { title, description, pubDate, updatedDate, cta, faq = [], keywords = [] } = entry.data;
const sectionInfo = sectionById(section);

/** MOFU 栏目（guide）文末 CTA 用「专业建议」语气 */
const tone = section === 'guide' ? 'mofu' : 'tofu';

/** 相关文章：同栏目最新 4 篇（不含自身） */
const related = (await getCollection(section as any, ({ data }: any) => !data.draft))
  .filter((e: any) => e.id !== entry.id)
  .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const pageUrl = new URL(Astro.url.pathname, SITE.url).href;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: sectionInfo.name, item: `${SITE.url}/${section}/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item: { q: string; a: string }) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogType="article"
  keywords={keywords}
>
  <div class="container layout-sidebar">
    <article>
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a> › <a href={`/${section}/`}>{sectionInfo.name}</a> › {title}
      </nav>
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-meta">
          发布于 {fmt(pubDate)}
          {updatedDate && (
            <>
              {' · '}
              <span class="updated">最后更新：{fmt(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      {/* FAQ（GEO 模块，与 FAQPage 结构化数据同源） */}
      {
        faq.length > 0 && (
          <section class="faq-section">
            <h2>常见问题</h2>
            {faq.map((item: { q: string; a: string }) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )
      }

      <CtaCard cta={cta} tone={tone} />

      {
        related.length > 0 && (
          <section class="related">
            <h2>相关文章</h2>
            <div class="article-list">
              {related.map((e: any) => (
                <ArticleCard
                  href={`/${section}/${e.id}/`}
                  title={e.data.title}
                  description={e.data.description}
                  date={e.data.pubDate}
                />
              ))}
            </div>
          </section>
        )
      }
    </article>

    <aside class="sidebar">
      <SidebarTop3 />
    </aside>
  </div>
</BaseLayout>
