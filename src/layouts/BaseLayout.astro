---
/**
 * 全站基础布局：SEO meta、Open Graph、canonical、JSON-LD、导航与页脚。
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** 页面级 JSON-LD 结构化数据（Article/Review/FAQ 等） */
  jsonLd?: object | object[];
  ogType?: string;
  /** SEO 关键词（meta keywords，Bing 参考） */
  keywords?: string[];
}

const { title, description, jsonLd, ogType = 'website', keywords = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.title ? title : `${title} - ${SITE.name}`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />

    {jsonLdList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
