---
/**
 * 评测详情页：按 frontmatter template 切换三种模板。
 * - ranking：榜单页（品牌卡片来自 airports.ts，正文为选购指南）
 * - review：单品牌评测（信息表 + 评分卡 + 测速图 + 优惠码 + 注册按钮 + 正文 + FAQ）
 * - vs：对比评测（正文 + 总榜 CTA）
 *
 * SEO/GEO：Article + BreadcrumbList + FAQPage（有 faq 时）+ ItemList（榜单）结构化数据。
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AirportCard from '../../components/AirportCard.astro';
import ScoreGrid from '../../components/ScoreGrid.astro';
import CouponBox from '../../components/CouponBox.astro';
import RegisterButton from '../../components/RegisterButton.astro';
import UnlockGrid from '../../components/UnlockGrid.astro';
import CtaCard from '../../components/CtaCard.astro';
import SidebarTop3 from '../../components/SidebarTop3.astro';
import { SITE } from '../../data/site';
import { BOARDS, boardById } from '../../data/boards';
import { byBoard, byId, overallScore } from '../../data/airports';

export async function getStaticPaths() {
  const entries = await getCollection('reviews', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, template, faq, keywords } = entry.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

/* ---- ranking 模板数据 ---- */
const board = template === 'ranking' && entry.data.board ? boardById(entry.data.board) : null;
const rankedAirports = template === 'ranking' && entry.data.board ? byBoard(entry.data.board) : [];

/* ---- review 模板数据 ---- */
const brand = template === 'review' && entry.data.brand ? byId(entry.data.brand) : null;
const overall = brand ? overallScore(brand) : null;

/* ---- JSON-LD ---- */
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: pageUrl,
    ...(brand ? { image: new URL(brand.speedImage, SITE.url).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '机场评测', item: `${SITE.url}/reviews/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
if (template === 'ranking' && rankedAirports.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    itemListElement: rankedAirports.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `${SITE.url}/reviews/${a.id}/`,
    })),
  });
}
if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item: { q: string; a: string }) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} ogType="article" keywords={keywords}>
  <div class="container layout-sidebar">
    <article>
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a> › <a href="/reviews/">机场评测</a> › {title}
      </nav>
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-meta">
          发布于 {fmt(pubDate)}
          {updatedDate && (
            <>
              {' · '}
              <span class="updated">最后更新：{fmt(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      {/* ============ ranking：榜单导航 + 排名卡片 ============ */}
      {
        template === 'ranking' && (
          <>
            <nav class="board-nav" aria-label="榜单导航">
              {Object.entries(BOARDS).map(([id, b]) => (
                <a href={b.path} class:list={[{ active: entry.data.board === id }]}>
                  {b.short}
                </a>
              ))}
              <a href="/brands/">品牌库</a>
            </nav>
            {rankedAirports.map((a, i) => (
              <AirportCard airport={a} rank={i + 1} />
            ))}
          </>
        )
      }

      {/* ============ review：品牌速览卡 ============ */}
      {
        template === 'review' && brand && (
          <div class="card review-summary">
            <div class="rs-head">
              <h2>{brand.name} 综合评分</h2>
              <span class="rs-score">{overall} / 10</span>
            </div>
            <p class="airport-tagline">{brand.tagline}</p>
            <ScoreGrid scores={brand.scores} />
            <table class="price-table">
              <tbody>
                <tr>
                  <th>起步价</th>
                  <td>
                    {brand.priceFrom}（{brand.trafficFrom}）
                  </td>
                  <th>线路类型</th>
                  <td>{brand.line}</td>
                </tr>
                <tr>
                  <th>协议</th>
                  <td>{brand.protocols.join(' / ')}</td>
                  <th>测速样本</th>
                  <td>{brand.nodeCount} 个节点</td>
                </tr>
                <tr>
                  <th>AI 工具</th>
                  <td>{brand.aiUnlock}</td>
                  <th>流媒体</th>
                  <td>{brand.streaming}</td>
                </tr>
                <tr>
                  <th>客户端</th>
                  <td colspan="3">{brand.clients}</td>
                </tr>
                <tr>
                  <th>节点地区</th>
                  <td colspan="3">{brand.regions.join('、')}</td>
                </tr>
              </tbody>
            </table>
            {brand.coupon && <CouponBox coupon={brand.coupon} note={brand.couponNote} />}
            <RegisterButton
              href={brand.url}
              label={brand.couponNote ? `${brand.name} 官网注册（${brand.couponNote}）` : `${brand.name} 官网注册`}
              block
            />
          </div>
        )
      }

      {/* ============ review：套餐价格详情表 ============ */}
      {
        template === 'review' && brand && brand.plans && brand.plans.length > 1 && (
          <div class="card plans-card" style="margin: 20px 0; padding: 18px 20px;">
            <h3 style="margin: 0 0 12px; font-size: 17px;">💳 {brand.name} 热门套餐与价格明细</h3>
            <table class="price-table" style="margin: 0;">
              <thead>
                <tr>
                  <th>套餐名称</th>
                  <th>计费价格</th>
                  <th>套餐流量</th>
                </tr>
              </thead>
              <tbody>
                {brand.plans.map((p) => (
                  <tr>
                    <td><strong>{p.name}</strong></td>
                    <td style="color: var(--cta); font-weight: 600;">{p.price}</td>
                    <td>{p.traffic}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      {/* ============ review：流媒体与 AI 解锁测试矩阵 ============ */}
      {
        template === 'review' && brand && (
          <UnlockGrid brandName={brand.name} />
        )
      }

      {/* ============ review：真实测速图与实测切片 ============ */}
      {
        template === 'review' && brand && (
          brand.hasRealSpeedtest !== false ? (
            <figure class="speed-figure">
              <img
                src={brand.speedImage}
                alt={brand.speedImageAlt}
                width={brand.speedImageWidth}
                height={brand.speedImageHeight}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {brand.name} 节点测速实测（测试环境：{brand.testEnv ?? '珠海联通 9Gbps / 32 线程并发'}；测速数据以图为准，实际体验受本地网络影响）
              </figcaption>
            </figure>
          ) : (
            <div class="card data-notice" style="margin: 20px 0; padding: 16px 20px; background: var(--bg-soft); border-left: 4px solid var(--accent);">
              <p style="margin: 0; font-size: 14px; color: var(--text-soft); line-height: 1.6;">
                <strong>📊 测速数据说明：</strong>当前品牌参数已收录至 HaiwaiLab 品牌库。本品牌独立 5Gbps 高并发节点测速图与晚高峰丢包监控正在采集排期中；文中指标根据品牌官方规格与网络协议综合整理。
              </p>
            </div>
          )
        )
      }

      {/* ============ review：专属流媒体/AI 解锁高清实测图集（如光速云等） ============ */}
      {
        template === 'review' && brand && brand.unlockImages && brand.unlockImages.length > 0 && (
          <section class="unlock-gallery-section" style="margin: 28px 0;">
            <h2 style="font-size: 20px; margin-bottom: 16px;">🔬 {brand.name} 节点流媒体与 AI 逐区实测截图</h2>
            <div class="unlock-gallery-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
              {brand.unlockImages.map((u) => (
                <figure style="margin: 0;" class="unlock-figure">
                  <img
                    src={u.url}
                    alt={u.alt}
                    width={u.width}
                    height={u.height}
                    loading="lazy"
                    decoding="async"
                    style="width: 100%; border: 1px solid var(--border); border-radius: var(--radius);"
                  />
                  <figcaption style="font-size: 12.5px; color: var(--text-soft); margin-top: 6px; text-align: center;">
                    {u.region}：{u.alt}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {/* ============ FAQ（GEO 模块，与 FAQPage 结构化数据同源） ============ */}
      {
        faq.length > 0 && (
          <section class="faq-section">
            <h2>常见问题</h2>
            {faq.map((item: { q: string; a: string }) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )
      }

      {/* ============ 页尾转化位 ============ */}
      {
        template === 'review' && brand && (
          <div class="card review-summary">
            <div class="rs-head">
              <h2>结论：{brand.name} 值得入手吗？</h2>
            </div>
            <p class="airport-tagline">{brand.tagline}</p>
            <div class="airport-actions">
              <RegisterButton
                href={brand.url}
                label={brand.couponNote ? `官网注册（${brand.couponNote}）` : '官网注册'}
              />
              <a class="review-link" href="/reviews/best/">
                对比其他机场 »
              </a>
              <a class="review-link" href="/brands/">
                查看品牌库 »
              </a>
            </div>
          </div>
        )
      }
      {template !== 'ranking' && template !== 'review' && <CtaCard cta="best" tone="mofu" />}
    </article>

    <aside class="sidebar">
      <SidebarTop3 />
    </aside>
  </div>
</BaseLayout>
