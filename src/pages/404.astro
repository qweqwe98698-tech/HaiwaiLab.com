---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 - 页面不存在" noindex={true}>
  <div class="container layout-single" style="text-align: center; padding-top: 80px;">
    <h1>404 · 页面不存在</h1>
    <p style="color: var(--text-soft);">你要找的页面可能已被移动或删除。</p>
    <p style="margin-top: 24px;">
      <a href="/" class="btn btn-secondary">返回首页</a>
      <a href="/reviews/best/" class="btn btn-register" style="margin-left: 12px;">看机场推荐</a>
    </p>
  </div>
</BaseLayout>
