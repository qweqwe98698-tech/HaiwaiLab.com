---
/**
 * 内部跳板路由 (/go/[id]/)
 * 
 * 架构规范：
 * 1. 承担全站所有外部服务商与商业链接的独立出站中转，阻断搜索引擎爬虫爬取外部第三方参数。
 * 2. 页面强制声明 noindex, nofollow，且在 robots.txt 中明确 Disallow: /go/。
 * 3. 排除在 sitemap-index.xml 之外，确保站内索引资产 100% 纯净。
 */
import { AIRPORTS } from '../../data/airports';
import { AFFILIATE_TARGETS } from '../../data/affiliate-targets';

export function getStaticPaths() {
  return AIRPORTS.map((a) => ({
    params: { id: a.id },
    props: {
      id: a.id,
      name: a.name,
      target: AFFILIATE_TARGETS[a.id] || `https://${a.id}.com/`,
    },
  }));
}

const { name, target } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>正在前往 {name} 官方网站 - HaiwaiLab</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f8fafc;
        color: #1e293b;
        padding: 20px;
        box-sizing: border-box;
      }
      .card {
        background: #ffffff;
        padding: 36px 32px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        max-width: 440px;
        width: 100%;
        text-align: center;
      }
      .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid #e2e8f0;
        border-top-color: #0e7490;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 20px;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      h1 {
        font-size: 1.15rem;
        margin: 0 0 12px;
        color: #0f172a;
      }
      p {
        font-size: 0.9rem;
        color: #64748b;
        margin: 0 0 24px;
        line-height: 1.5;
      }
      a.btn {
        display: inline-block;
        padding: 10px 24px;
        background: #0e7490;
        color: #ffffff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.2s;
      }
      a.btn:hover {
        background: #155e75;
      }
    </style>
    <script define:vars={{ target }}>
      if (typeof window !== 'undefined' && target) {
        window.location.replace(target);
      }
    </script>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <h1>正在前往 {name}</h1>
      <p>正在为您安全重定向至官网，如果页面未自动跳转，请点击下方按钮直接前往：</p>
      <a href={target} class="btn" rel="nofollow sponsored">直接前往官网 →</a>
    </div>
  </body>
</html>
